{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "TurboIntegrator",
    "patterns": [
        {
            "comment": "Rule area definition (e.g. ['Sales', 'Jan'])",
            "match": "\\[[^\\]]*\\]",
            "name": "variable.parameter.tm1"
        },
        {
            "comment": "Rule side definition (!Dimension)",
            "match": "![a-zA-Z0-9_àáâãäåæçèéêëìíîïðñòóôõöøùúûüýþÿßÀÁÂÃÄÅÆÇÈÉÊËÌÍÎÏÐÑÒÓÔÕÖØÙÚÛÜÝÞ ]+",
            "name": "variable.language.tm1"
        },
        {
            "comment": "Rule qualifiers (N:, C:, S:)",
            "match": "\\b(?i)(N|C|S):",
            "name": "keyword.control.tm1"
        },
        {
            "comment": "Rule section keywords",
            "match": "\\b(?i)(FEEDERS|SKIPCHECK|FEEDSTRINGS)\\b",
            "name": "keyword.control.tm1"
        },
        {
            "comment": "Section markers (#SECTION must come before the generic comment rule)",
            "match": "^#SECTION.*",
            "name": "comment.line.number-sign.tm1"
        },
        {
            "comment": "JSON properties block marker",
            "match": "^#JSON_PROPERTIES.*",
            "name": "comment.line.number-sign.tm1"
        },
        {
            "comment": "TM1 generated block markers",
            "match": "^#\\*+.*",
            "name": "comment.line.number-sign.tm1"
        },
        {
            "comment": "Comments (everything after a standalone #)",
            "match": "#.*",
            "name": "comment.line.number-sign.tm1"
        },
        {
            "comment": "Strings (single quotes)",
            "begin": "'",
            "end": "'",
            "name": "string.quoted.single.tm1"
        },
        {
            "comment": "Numbers",
            "match": "\\b\\d+(\\.\\d+)?\\b",
            "name": "constant.numeric.tm1"
        },
        {
            "comment": "Control flow and Rule keywords",
            "match": "\\b(?i)(IF|ELSE|ELSEIF|ENDIF|WHILE|END|FOR|NEXT|BREAK|RETURN|CONTINUE|STET|UNDEFVALS)\\b",
            "name": "keyword.control.tm1"
        },
        {
            "comment": "Operators",
            "match": "(@=|@<>|@<|@>|<>|<=|>=|<|>|=|\\+|-|\\*|\\/|&|\\|)",
            "name": "keyword.operator.tm1"
        },
        {
            "comment": "All TM1 / Rules / TurboIntegrator functions",
            "match": "\\b(?i)(AsciiOutput|TextOutput|Char|Code|Delet|Expand|Fill|Insrt|Long|Lower|Upper|Trim|Scan|Subst|NumberToString|NumberToStringEx|StringToNumber|StringToNumberEx|AttrDelete|AttrInsert|AttrGetN|AttrGetS|AttrPutN|AttrPutS|ATTRS|ATTRN|ElementAttrDelete|ElementAttrInsert|ElementAttrN|ElementAttrS|ElementAttrPutN|ElementAttrPutS|ChoreAdd|ChoreClear|ChoreQuit|CellGetN|CellGetS|CellIncrementN|CellPutN|CellPutS|CellPutProportionalSpread|CellIsUpdateable|CellIsUpdateableEx|CellSecurityGet|CubeClearData|CubeCreate|CubeDestroy|CubeExists|CubeGetLogChanges|CubeSetLogChanges|CubeProcessFeeders|CubeSaveData|CubeElementInsert|HierarchyCount|HierarchyCreate|HierarchyDestroy|HierarchyExists|HierarchyElementInsert|HierarchyElementDelete|HierarchyElementComponentAdd|HierarchyElementComponentDelete|DimensionCreate|DimensionDestroy|DimensionDeleteAllElements|DimensionElementComponentAdd|DimensionElementComponentDelete|DimensionElementDelete|DimensionElementInsert|DimensionElementInsertDirect|DimensionElementPrincipalName|DimensionExists|DimensionSortOrder|DimensionTopElementCount|Dimix|Dimnm|Dimsiz|DIMIX|DIMNM|DIMSIZ|Elcomp|ElcompN|Elisleav|Elpar|ElparN|ELCOMP|ELCOMPN|ELLEV|ELISANC|ELISCOMP|ELISPAR|ELWEIGHT|DTYPE|SubsetAliasSet|SubsetCreate|SubsetCreateByMDX|SubsetDeleteAllElements|SubsetDestroy|SubsetElementDelete|SubsetElementInsert|SubsetExists|SubsetGetElementName|SubsetGetSize|SubsetMDXGet|SubsetMDXSet|SubsetToSet|ViewColumnDimensionSet|ViewCreate|ViewDestroy|ViewExists|ViewExtractSkipCalcsSet|ViewExtractSkipRuleValuesSet|ViewExtractSkipZeroesSet|ViewExtractSkipConsolidatedValuesSet|ViewExtractSkipConsolidatedStringsSet|AddCubeDependency|AddInfoCubeRestriction|ASCIIDelete|ASCIIOutputOpen|AssociateCAMIDToGroup|ATTRNL|ATTRSL|BatchUpdateFinish|BatchUpdateFinishWait|CellSecurityCubeCreate|CellSecurityCubeDestroy|ChoreAttrDelete|ChoreAttrInsert|ChoreAttrN|ChoreAttrNL|ChoreAttrPutN|ChoreAttrPutS|ChoreAttrS|ChoreAttrSL|ChoreError|ChoreRollback|CreateHierarchyByAttrib