    "configuration": {
      "title": "PA Code",
      "properties": {
        "pa-code.mcpServer.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Provide a real MCP server (Tools + Resources + Prompts) backed by the live TM1 connection. Exposes read-only TM1 tools, tm1:// resources (process code, cube rules, cube dimensions, server info) and reusable prompts (explain process, review rules, impact analysis). Available to the built-in Copilot agent AND to any other MCP-aware AI tool (Claude Code/Desktop, Codex, Cline, Continue, …) via 'PA Code: Show MCP Endpoint'. Read-only by default; opt into write / model-building tools with 'pa-code.mcpServer.mode'."
        },
        "pa-code.mcpServer.port": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 65535,
          "description": "Fixed loopback port for the MCP server. 0 (default) lets the OS assign a random port each session (fine for the Copilot agent). Set a fixed port (e.g. 3900) for a stable URL when connecting external AI tools such as Claude Code/Desktop, Codex, Cline or Continue. The server always binds to 127.0.0.1 only."
        },
        "pa-code.mcpServer.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "Start the MCP server immediately when the extension activates, instead of lazily on first use. Enable this when an external AI tool (e.g. Codex) connects on its own and needs the loopback endpoint to be listening right away — without waiting for VS Code/Copilot to request the server first. Best combined with a fixed 'Port'."
        },
        "pa-code.mcpServer.tokenEnvVar": {
          "type": "string",
          "default": "",
          "description": "Name of an environment variable that holds the MCP bearer token. When set (and the variable is non-empty), the server uses that token instead of the auto-generated one stored in SecretStorage. This lets an external client that reads the token from an env var (e.g. Codex's '--bearer-token-env-var') share the exact same token. Example: PA_CODE_MCP_TOKEN. Leave empty to use the built-in persisted token."
        },
        "pa-code.mcpServer.mode": {
          "type": "string",
          "enum": ["readonly", "readwrite"],
          "enumDescriptions": [
            "Only read tools are exposed. The agent can inspect the model but cannot change anything.",
            "Adds write / model-building tools (create & delete cubes, dimensions, elements, edges, rules, TI processes, views, subsets, chores, security; write cells; execute processes/chores). Destructive tools require a confirm argument."
          ],
          "default": "readonly",
          "markdownDescription": "MCP server capability level. **readonly** (default) exposes only read tools. **readwrite** additionally exposes write / model-building tools so an AI agent can create and manipulate TM1 objects (e.g. build a full model from a spreadsheet). Destructive actions (all deletes, cell writes, rule replacement, process/chore execution, config changes) require a `confirm` argument that repeats the target name. Only point a read/write server at a database whose account has the rights the agent should have."
        },
        "pa-code.integratedLogin.kerberosSpn": {
          "type": "string",
          "default": "",
          "description": "Optional explicit Kerberos service principal name (SPN) for Integrated Login. Leave empty (default) to derive it automatically as HTTP/<server-FQDN>. Set this only if auto-detection fails — e.g. 'HTTP/tm1host.corp.example.com' — to match exactly the SPN registered in Active Directory (setspn -S HTTP/<fqdn> <account>). Applies to all Integrated Login connections."
        },
        "pa-code.projectFile.location": {
          "type": "string",
          "default": "",
          "description": "Legacy only: where to store the 'tm1-project.json' file when you keep file-based connections. Empty (default) uses the workspace root. Set a folder (e.g. your non-git Local Workspace Folder) or a full path ending in '.json'. New connections are stored in VS Code by default and do not create this file; see 'PA Code: Move Connections into VS Code'."
        },
        "pa-code.connections.defaultScope": {
          "type": "string",
          "enum": [
            "workspace",
            "global"
          ],
          "enumDescriptions": [
            "Store new connections for this VS Code workspace only.",
            "Store new connections globally, so they are available in every workspace for your user."
          ],
          "default": "workspace",
          "description": "Where new connections are saved when no scope is chosen. Connections are stored in VS Code (not in a file). Use 'global' to reuse the same connections across different workspaces. Each connection's scope can also be changed in the connection editor."
        },
        "pa-code.autoPushOnSave": {
          "type": "boolean",
          "default": true,
          "description": "When enabled (default), saving a .ti / .rux file pushes it to the connected TM1 server. Turn it off to work in a manual-publish workflow: edits stay local (and can be committed to git) until you run 'PA Code: Publish Changed Files'. Toggle via the 'TM1: Auto-Push' status bar item."
        },
        "pa-code.auth.privateBrowserWindow": {
          "type": "boolean",
          "default": false,
          "description": "For CAM Browser SSO: open the login browser in a private/incognito window (Chrome --incognito / Edge --inprivate). Useful to bypass an existing SSO session and sign in as a different account (e.g. an admin on a production instance), instead of being auto-logged-in with your saved credentials."
        },
        "pa-code.delight.celebrateProcessSuccess": {
          "type": "boolean",
          "default": false,
          "description": "Delightful UX (off by default): after a TI process runs successfully, play a short celebration. Choose the style with 'pa-code.delight.celebrationStyle'."
        },
        "pa-code.delight.celebrationStyle": {
          "type": "string",
          "enum": [
            "balloons",
            "fireworks",
            "panel"
          ],
          "enumDescriptions": [
            "Animated toast with rising balloons, then a persistent success message.",
            "Animated toast with rockets and a burst, then a persistent success message.",
            "A short-lived panel beside the editor with floating balloons (inspired by Streamlit's st.balloons)."
          ],
          "default": "balloons",
          "description": "How to celebrate a successful process run when 'pa-code.delight.celebrateProcessSuccess' is on."
        },
        "pa-code.delight.funMessages": {
          "type": "boolean",
          "default": true,
          "description": "Delightful UX (on by default): use a random cheerful phrase (e.g. 'Nailed it! 🎯', 'Clean run ✨') for the process-success message instead of the standard text."
        },
        "pa-code.delight.dailyGreeting": {
          "type": "boolean",
          "default": true,
          "description": "Delightful UX (on by default): show a short, time-of-day greeting the first time you connect to a TM1 server each day."
        },
        "pa-code.delight.progressPersonality": {
          "type": "boolean",
          "default": true,
          "description": "Delightful UX (on by default): use playful progress messages during 'Pull All' (e.g. 'Fetching your processes… 🧰') instead of the plain text."
        },
        "pa-code.deployment.logEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable deployment transport logging. When enabled, each deployment writes a JSON log file."
        },
        "pa-code.deployment.logDirectory": {
          "type": "string",
          "default": "",
          "description": "Directory for deployment transport log files. Absolute path or relative to workspace root."
        },
        "pa-code.proxy.debug": {
          "type": "boolean",
          "default": false,
          "description": "Enable proxy diagnostic logging. When enabled, every request logs its DIRECT/PROXY routing decision to the 'PA Code (Proxy)' output channel. Use the command 'PA Code: Show Proxy Diagnostic Log' to view it."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.106.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "eslint": "^9.39.1",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "axios-ntlm": "^1.4.6",
    "http-proxy-agent": "^5.0.0",
    "https-proxy-agent": "^5.0.1",
    "kerberos": "^7.0.0",
    "puppeteer-core": "^24.43.1"
  }
}
