  "main": "./dist/extension.js",
  "contributes": {
    "breakpoints": [
      {
        "language": "tm1"
      }
    ],
    "debuggers": [
      {
        "type": "tm1",
        "label": "TM1 Process Debugger",
        "languages": [
          "tm1"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to the .ti process file to debug.",
                "default": "${file}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop on the first line of the process.",
                "default": true
              },
              "parameters": {
                "type": "array",
                "description": "Process parameters as [{Name, Value}] pairs.",
                "default": []
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "tm1",
            "request": "launch",
            "name": "Debug TI Process",
            "program": "${file}",
            "stopOnEntry": true
          }
        ],
        "configurationSnippets": [
          {
            "label": "TM1: Debug TI Process",
            "description": "Debug a TurboIntegrator process",
            "body": {
              "type": "tm1",
              "request": "launch",
              "name": "Debug ${1:Process}",
              "program": "^\"${2:${file}}\"",
              "stopOnEntry": true
            }
          }
        ]
      }
    ],
    "languages": [
      {
        "id": "tm1",
        "aliases": [
          "TurboIntegrator",
          "TM1"
        ],
        "extensions": [
          ".ti",
          ".pro",
          ".rux"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tm1",
        "scopeName": "source.tm1",
        "path": "./syntaxes/tm1.tmLanguage.json"
      }
    ],
